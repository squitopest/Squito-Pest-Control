# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI runtime scratch — auto-generated per-machine and per-link,
# never meant to be committed.
supabase/.temp/

# Local CLI binaries (Stripe CLI, etc.) — per-developer tooling, never shipped.
/bin/
*.exe
data/

# Audit cleanup — dev-only artifacts that don't belong in the repo
screenshots/
linear-design/
success_video.mp4
screenshot-pages.js
setup-blog.mjs
create-blog-table.mjs
check-tables.mjs
check.mjs
scripts/audit*.mjs
scripts/peek-csv.mjs
scripts/check-properties.mjs
scripts/fix-mt.mjs

# Local design scratch (Stitch prompts, HTML exports)
docs/design/

# Python bytecode from local skill scripts
**/__pycache__/
*.pyc
